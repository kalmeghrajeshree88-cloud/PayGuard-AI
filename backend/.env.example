# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Auth (use a long random string, e.g. run: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Database (leave blank to use the built-in in-memory store for quick demos)
MONGO_URI=

# AI intent extraction (leave blank to use the built-in rule-based parser)
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# PayPal Sandbox (leave blank to run payments in simulated mode)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Needed only for webhooks (PayPal dashboard -> your app -> Webhooks; URL must be public, e.g. Render or ngrok)
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
INR_PER_USD=83

# Demo mode shows the one-time code in the API response (never enable in production)
DEMO_MODE=true
